# Copy to .env.local for local dev. In Vercel, every one of these must be set
# as a "Sensitive" environment variable, never a regular one — see
# docs/phase-1-prd.md §9 (Security checklist). Never commit real values.

# Meta / Instagram Graph API — one Page-linked token per account
META_APP_ID=
META_TOKEN_FRANCIS=
META_TOKEN_BAILEY=
META_IG_USER_ID_FRANCIS=17841403400545180
META_IG_USER_ID_BAILEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Gmail API — digest send for Phase 1 (gmail.send scope only; gmail.compose
# is Phase 5's outreach concern, not this one)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN_FRANCIS=
GMAIL_REFRESH_TOKEN_BAILEY=
